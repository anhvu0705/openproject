# Google Cloud SDK gcloud ignore file
# This file specifies which files/folders to exclude from gcloud source uploads

# Git files and directories
.git
.gitignore
.gitattributes
.github

# Node.js dependencies (if applicable)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Ruby/Rails files (OpenProject uses these)
Gemfile.lock
.bundle/
.gems/
vendor/gems/

# Development files
.env
.env.local
.env.*.local
.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Build artifacts and cache
build/
dist/
*.egg-info/
.cache/
.pytest_cache/
.tox/
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp
*.log
*.bak
*.backup
*~
.~

# Docker files (kept for local development reference)
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD files (already handled by cloud build)
.github/workflows/
CI_CD_SETUP.md

# Documentation files
*.md
README.md
DEPLOYMENT_COMPLETE.md
QUICK_START.md
CLOUD_RUN_DEPLOYMENT.md

# Test files
test/
tests/
spec/
*.test.js
*.spec.js

# Local development
localhost/*
.local/

# Database files
*.db
*.sqlite
*.sqlite3
*.sql

# OS specific
Thumbs.db
.DS_Store

# OpenProject specific
client/dist/
public/assets/
public/javascripts/
public/stylesheets/
public/uploads/
log/
tmp/

# Sensitive files
.ssh/
.aws/
.gcp/
.env.production
secrets/
**/secret*
